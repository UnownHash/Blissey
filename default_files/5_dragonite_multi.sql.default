-- settings
select @period := concat(date(now() - interval 15 minute),' ', SEC_TO_TIME((TIME_TO_SEC(time(now() - interval 15 minute)) DIV 300) * 300));
select @rpl  := 5;

-- aggregation area/generic
INSERT IGNORE INTO multiblissey.dragoLog (datetime,rpl,rpc4,rpc5,rpc6,rpc7,rpc8,rpc9,rpc11,rpc12,rpc13,rpc14,rpc15,rpc16,rpc17,rpc18,mitm500,mitm501,mitm502,mitm503,mitmLoginErr,proxyBan,wsError,wsClose,wsMitmRecon,authReq,authed,login,swTotal,swWarnSusp,swBanned,swSbanned,swDisabled,swDayLimit,swRange,swTime,swStop,swLLapi,swQdist,swConsecRPC,backoff,noAccount,released24h,released7d,minAuthT,maxAuthT,avgAuthT,monchange,totRemoteAuth,failRemoteAuth,faultyRemoteAuth,minRemoteAuthT,maxRemoteAuthT,avgRemoteAuthT,lowDuration,bgRefreshSuc,bgRefreshFail,bTokenReq,bTokenSuc,bTokenMin,bTokenMax,bTokenAvg,tokenCleared)
SELECT
@period,
@rpl,
sum(rpc4),
sum(rpc5),
sum(rpc6),
sum(rpc7),
sum(rpc8),
sum(rpc9),
sum(rpc11),
sum(rpc12),
sum(rpc13),
sum(rpc14),
sum(rpc15),
sum(rpc16),
sum(rpc17),
sum(rpc18),
sum(mitm500),
sum(mitm501),
sum(mitm502),
sum(mitm503),
sum(mitmLoginErr),
sum(proxyBan),
sum(wsError),
sum(wsClose),
sum(wsMitmRecon),
sum(authReq),
sum(authed),
sum(login),
sum(swTotal),
sum(swWarnSusp),
sum(swBanned),
sum(swSbanned),
sum(swDisabled),
sum(swDayLimit),
sum(swRange),
sum(swTime),
sum(swStop),
sum(swLLapi),
sum(swQdist),
sum(swConsecRPC),
sum(backoff),
sum(noAccount),
sum(released24h),
sum(released7d),
min(minAuthT),
max(maxAuthT),
sum(avgAuthT),
sum(monchange),
sum(totRemoteAuth),
sum(failRemoteAuth),
sum(faultyRemoteAuth),
min(minRemoteAuthT),
max(maxRemoteAuthT),
sum(avgRemoteAuthT),
sum(lowDuration),
sum(bgRefreshSuc),
sum(bgRefreshFail),
sum(bTokenReq),
sum(bTokenSuc),
min(bTokenMin),
max(bTokenMax),
sum(bTokenAvg),
sum(tokenCleared)

FROM singleblissey.dragoLog
WHERE datetime=@period and rpl=@rpl

on duplicate key update
  rpc4=rpc4+values(rpc4),
  rpc5=rpc5+values(rpc5),
  rpc6=rpc6+values(rpc6),
  rpc7=rpc7+values(rpc7),
  rpc8=rpc8+values(rpc8),
  rpc9=rpc9+values(rpc9),
  rpc11=rpc11+values(rpc11),
  rpc12=rpc12+values(rpc12),
  rpc13=rpc13+values(rpc13),
  rpc14=rpc14+values(rpc14),
  rpc15=rpc15+values(rpc15),
  rpc16=rpc16+values(rpc16),
  rpc17=rpc17+values(rpc17),
  rpc18=rpc18+values(rpc18),
  mitm500=mitm500+values(mitm500),
  mitm501=mitm501+values(mitm501),
  mitm502=mitm502+values(mitm502),
  mitm503=mitm503+values(mitm503),
  mitmLoginErr=mitmLoginErr+values(mitmLoginErr),
  mitm501price=mitm501price+values(mitm501price),
  mitm501sn=mitm501sn+values(mitm501sn),
  mitm501backend=mitm501backend+values(mitm501backend),
  proxyBan=proxyBan+values(proxyBan),
  wsError=wsError+values(wsError),
  wsClose=wsClose+values(wsClose),
  wsMitmRecon=wsMitmRecon+values(wsMitmRecon),
  authReq=authReq+values(authReq),
  authed=authed+values(authed),
  login=login+values(login),
  swTotal=swTotal+values(swTotal),
  swWarnSusp=swWarnSusp+values(swWarnSusp),
  swBanned=swBanned+values(swBanned),
  swSbanned=swSbanned+values(swSbanned),
  swDisabled=swDisabled+values(swDisabled),
  swDayLimit=swDayLimit+values(swDayLimit),
  swRange=swRange+values(swRange),
  swTime=swTime+values(swTime),
  swStop=swStop+values(swStop),
  swLLapi=swLLapi+values(swLLapi),
  swQdist=swQdist+values(swQdist),
  swConsecRPC=swConsecRPC+values(swConsecRPC),
  backoff=backoff+values(backoff),
  noAccount=noAccount+values(noAccount),
  released24h=released24h+values(released24h),
  released7d=released7d+values(released7d),
  minAuthT=least(minAuthT,values(minAuthT)),
  maxAuthT=greatest(maxAuthT,values(maxAuthT)),
  avgAuthT=((avgAuthT*authed) + (values(avgAuthT)*values(authed))) / (authed+values(authed)),
  monchange=monchange+values(monchange),
  totRemoteAuth=totRemoteAuth+values(totRemoteAuth),
  failRemoteAuth=failRemoteAuth+values(failRemoteAuth),
  faultyRemoteAuth=faultyRemoteAuth+values(faultyRemoteAuth),
  minRemoteAuthT=least(minRemoteAuthT,values(minRemoteAuthT)),
  maxRemoteAuthT=greatest(maxRemoteAuthT,values(maxRemoteAuthT)),
  avgRemoteAuthT=((avgRemoteAuthT*totRemoteAuth) + (values(avgRemoteAuthT)*values(totRemoteAuth))) / (totRemoteAuth+values(totRemoteAuth)),
  lowDuration=lowDuration+values(lowDuration),
  bgRefreshSuc=bgRefreshSuc+values(bgRefreshSuc),
  bgRefreshFail=bgRefreshFail+values(bgRefreshFail),
  bTokenReq=bTokenReq+values(bTokenReq),
  bTokenSuc=bTokenSuc+values(bTokenSuc),
  bTokenMin=least(bTokenMin,values(bTokenMin)),
  bTokenMax=greatest(bTokenMax,values(bTokenMax)),
  bTokenAvg=((bTokenAvg*bTokenSuc) + (values(bTokenAvg)*values(bTokenSuc))) / (bTokenSuc+values(bTokenSuc)),
  tokenCleared=tokenCleared+values(tokenCleared)
;

-- aggregation invasion
INSERT IGNORE INTO multiblissey.dragoLog_invasion (datetime,rpl,rpc4,rpc5,rpc6,rpc7,rpc8,rpc9,rpc11,rpc12,rpc13,rpc14,rpc15,rpc16,rpc17,rpc18,swTotal,swWarnSusp,swBanned,swSbanned,swDisabled,swDayLimit,swRange,swTime,swStop,swLLapi,swQdist,swConsecRPC,backoff)
SELECT
@period,
@rpl,
sum(rpc4),
sum(rpc5),
sum(rpc6),
sum(rpc7),
sum(rpc8),
sum(rpc9),
sum(rpc11),
sum(rpc12),
sum(rpc13),
sum(rpc14),
sum(rpc15),
sum(rpc16),
sum(rpc17),
sum(rpc18),
sum(swTotal),
sum(swWarnSusp),
sum(swBanned),
sum(swSbanned),
sum(swDisabled),
sum(swDayLimit),
sum(swRange),
sum(swTime),
sum(swStop),
sum(swLLapi),
sum(swQdist),
sum(swConsecRPC),
sum(backoff)

FROM singleblissey.dragoLog_invasion
WHERE datetime=@period and rpl=@rpl

on duplicate key update
  rpc4=rpc4+values(rpc4),
  rpc5=rpc5+values(rpc5),
  rpc6=rpc6+values(rpc6),
  rpc7=rpc7+values(rpc7),
  rpc8=rpc8+values(rpc8),
  rpc9=rpc9+values(rpc9),
  rpc11=rpc11+values(rpc11),
  rpc12=rpc12+values(rpc12),
  rpc13=rpc13+values(rpc13),
  rpc14=rpc14+values(rpc14),
  rpc15=rpc15+values(rpc15),
  rpc16=rpc16+values(rpc16),
  rpc17=rpc17+values(rpc17),
  rpc18=rpc18+values(rpc18),
  swTotal=swTotal+values(swTotal),
  swWarnSusp=swWarnSusp+values(swWarnSusp),
  swBanned=swBanned+values(swBanned),
  swSbanned=swSbanned+values(swSbanned),
  swDisabled=swDisabled+values(swDisabled),
  swDayLimit=swDayLimit+values(swDayLimit),
  swRange=swRange+values(swRange),
  swTime=swTime+values(swTime),
  swStop=swStop+values(swStop),
  swLLapi=swLLapi+values(swLLapi),
  swQdist=swQdist+values(swQdist),
  swConsecRPC=swConsecRPC+values(swConsecRPC),
  backoff=backoff+values(backoff)
;

