##### Blissey #####
## Every 5 minutes (except full and quarter hours)
5,10,20,25,35,40,50,55 * * * * cd blisseypath/cron_files && ./5.sh
## Every quarter hour
15,30,45 * * * * cd blisseypath/cron_files && ./5.sh && ./15.sh
## Every hour, except midnight
0 1-23 * * * cd blisseypath/cron_files && ./logrotate.sh && ./5.sh && ./15.sh && ./60.sh
## Midnight
0 0 * * * cd blisseypath/cron_files && ./logger.sh && ./logrotate.sh && ./5.sh && ./15.sh && ./60.sh && ./1440.sh
## Weekly (monday)
10 0 * * 1 cd blisseypath/cron_files && ./10080.sh
